<?xml version="1.0" encoding="UTF-8"?>
<!-- Project-local settings: always resolve from Maven Central, ignoring any
     corporate mirror in ~/.m2/settings.xml. Picked up via .mvn/maven.config. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
  <mirrors>
    <mirror>
      <id>central</id>
      <mirrorOf>*</mirrorOf>
      <url>https://repo.maven.apache.org/maven2</url>
    </mirror>
  </mirrors>
</settings>
